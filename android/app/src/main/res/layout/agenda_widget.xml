<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/agenda_root" android:layout_width="match_parent" android:layout_height="match_parent">
  <ImageView android:id="@+id/agenda_surface" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:contentDescription="" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="26dp" android:orientation="horizontal">
      <TextView android:id="@+id/agenda_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
      <TextView android:id="@+id/agenda_add" android:layout_width="32dp" android:layout_height="match_parent" android:gravity="center" android:text="+" android:textSize="22sp" android:contentDescription="添加日程" />
    </LinearLayout>
    <ListView android:id="@+id/agenda_rows" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@android:color/transparent" android:dividerHeight="0dp" android:scrollbars="vertical" />
    <TextView android:id="@+id/agenda_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="今天暂无日程" android:textSize="12sp" />
  </LinearLayout>
</FrameLayout>
